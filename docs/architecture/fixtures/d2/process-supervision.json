{
  "fixtureVersion": 1,
  "profile": "d2-v1",
  "kind": "process-supervision",
  "cases": [
    {
      "id": "d2.process.executable-version-pinned",
      "description": "A lease records and rechecks immutable executable identity before launch.",
      "given": { "configuredPath": "/opt/blackglass/fixtures/fake-exec", "resolvedPath": "/opt/blackglass/fixtures/fake-exec", "regularFile": true, "symlink": false, "device": 2049, "inode": 7001, "digest": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "observedVersion": "fixture-exec 1.0.0", "executableByRunner": true },
      "expected": { "registered": true, "immutableVersion": 1, "launchRecheckRequired": true }
    },
    {
      "id": "d2.process.missing-executable",
      "description": "A missing registry executable is a truthful capability error before spawn.",
      "given": { "configuredPath": "/opt/blackglass/fixtures/missing-exec", "exists": false },
      "error": { "code": "executable_missing", "spawnCount": 0 }
    },
    {
      "id": "d2.process.relative-executable-rejected",
      "description": "Executable registry paths must be absolute.",
      "given": { "configuredPath": "fixtures/fake-exec", "regularFile": true },
      "error": { "code": "executable_path_not_absolute", "registered": false }
    },
    {
      "id": "d2.process.symlink-executable-rejected",
      "description": "Registry inspection never follows a symlink executable.",
      "given": { "configuredPath": "/opt/blackglass/fixtures/fake-link", "symlink": true, "linkDestination": "/opt/blackglass/fixtures/fake-exec" },
      "error": { "code": "executable_symlink_rejected", "registered": false }
    },
    {
      "id": "d2.process.executable-changed-before-launch",
      "description": "A changed inode or digest disables the pinned registry version.",
      "given": { "registeredInode": 7001, "currentInode": 7002, "registeredDigest": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "currentDigest": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" },
      "error": { "code": "executable_identity_changed", "spawnCount": 0, "registryVersionDisabled": true }
    },
    {
      "id": "d2.process.argv-metacharacters-are-literal",
      "description": "Shell metacharacters remain one literal argv value and never execute.",
      "given": { "executable": "/opt/blackglass/fixtures/fake-exec", "argv": ["scan", "target.test;touch", "/tmp/fixture-owned"], "shell": false },
      "expected": { "spawnExecutable": "/opt/blackglass/fixtures/fake-exec", "spawnArgv": ["scan", "target.test;touch", "/tmp/fixture-owned"], "sideEffectCreated": false }
    },
    {
      "id": "d2.process.command-string-contract-rejected",
      "description": "A command string or raw flags field is impossible in the process contract.",
      "given": { "executable": "/opt/blackglass/fixtures/fake-exec", "command": "fake-exec target.test", "rawFlags": "--fixture" },
      "error": { "code": "invalid_process_contract", "spawnCount": 0 }
    },
    {
      "id": "d2.process.environment-denied",
      "description": "Ambient and dangerous environment names are rejected.",
      "given": { "requestedEnvironment": { "LD_PRELOAD": "/opt/blackglass/fixtures/fake-library", "HTTP_PROXY": "http://proxy.test", "UNDECLARED_FIXTURE": "value" }, "declaredNames": [] },
      "error": { "code": "environment_variable_denied", "spawnCount": 0, "deniedNames": ["HTTP_PROXY", "LD_PRELOAD", "UNDECLARED_FIXTURE"] }
    },
    {
      "id": "d2.process.minimal-environment",
      "description": "The runner constructs a predictable environment instead of inheriting its service environment.",
      "given": { "ambientInherited": false, "runDirectory": "/var/lib/blackglass-runner/runs/run-fixture-18" },
      "expected": { "environment": { "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "TZ": "UTC", "PATH": "/usr/bin:/bin", "TMPDIR": "/var/lib/blackglass-runner/runs/run-fixture-18/tmp" } }
    },
    {
      "id": "d2.process.cwd-escape-rejected",
      "description": "Caller-controlled traversal cannot choose the working directory.",
      "given": { "runnerRoot": "/var/lib/blackglass-runner/runs", "requestedCwd": "../outside", "generatedCwd": false },
      "error": { "code": "working_directory_escape", "spawnCount": 0 }
    },
    {
      "id": "d2.process.cancel-before-escalation",
      "description": "A cooperative process group exits after SIGTERM without SIGKILL.",
      "given": { "state": "cancel_requested", "processGroup": 4301, "termGraceMs": 5000, "killVerifyMs": 2000, "exitsAfterTermMs": 50 },
      "expected": { "signals": ["SIGTERM"], "descendantsRemaining": 0, "terminalState": "cancelled" }
    },
    {
      "id": "d2.process.cancel-escalates-and-cleans-descendants",
      "description": "An uncooperative process and descendants receive bounded escalation.",
      "given": { "state": "cancel_requested", "processGroup": 4302, "descendantCount": 3, "termGraceMs": 5000, "killVerifyMs": 2000, "exitsAfterTermMs": null },
      "expected": { "signals": ["SIGTERM", "SIGKILL"], "descendantsRemaining": 0, "terminalState": "cancelled" }
    },
    {
      "id": "d2.process.descendant-cleanup-failure",
      "description": "Unverified cleanup fails the Run and stops new admission.",
      "given": { "state": "cancel_requested", "processGroup": 4303, "descendantsAfterKill": 1, "killVerifyMs": 2000 },
      "error": { "code": "process_cleanup_failed", "terminalState": "failed", "runnerHealthy": false, "newLeaseAllowed": false, "workingDirectoryQuarantined": true }
    },
    {
      "id": "d2.process.duration-timeout",
      "description": "A duration limit uses the same cleanup path but reports failure truthfully.",
      "given": { "state": "running", "durationLimitMs": 60000, "elapsedMs": 60001, "cleanupVerified": true },
      "expected": { "terminalState": "failed", "reason": "duration_exceeded", "partialEvidencePreserved": true }
    },
    {
      "id": "d2.process.unsupported-finite-resource-control",
      "description": "A finite limit cannot be silently ignored without delegated cgroup support.",
      "given": { "delegatedCgroupV2": false, "requestedControl": "memory_limit", "requestedValueBytes": 268435456 },
      "error": { "code": "resource_control_unsupported", "leaseAllowed": false, "limitReportedAsEnforced": false }
    },
    {
      "id": "d2.process.unsupported-file-limit",
      "description": "Finite file-size and open-file controls are explicitly unavailable in v0.1.",
      "given": { "profile": "d2-v1", "requestedControls": { "fileSizeBytes": 1048576, "openFiles": 64 } },
      "error": { "code": "resource_control_unsupported", "unsupported": ["file_size", "open_files"], "leaseAllowed": false }
    },
    {
      "id": "d2.process.output-backpressure",
      "description": "Unacknowledged output pauses reads at the high-water mark and uses bounded batches.",
      "given": { "unacknowledgedBytes": 262144, "highWaterBytes": 262144, "batchBytes": 32768 },
      "expected": { "pipeReadsPaused": true, "maximumBatchBytes": 32768, "memoryGrowthBounded": true }
    },
    {
      "id": "d2.process.output-truncation",
      "description": "Excess output is drained and counted without deadlocking the child.",
      "given": { "combinedRetainedLimitBytes": 16777216, "stdout": { "bytesSeen": 17825792, "bytesRetained": 16777216 }, "stderr": { "bytesSeen": 1024, "bytesRetained": 0 } },
      "expected": { "stdout": { "bytesSeen": 17825792, "bytesRetained": 16777216, "bytesDropped": 1048576, "firstDroppedOffset": 16777216, "truncated": true }, "stderr": { "bytesSeen": 1024, "bytesRetained": 0, "bytesDropped": 1024, "firstDroppedOffset": 0, "truncated": true }, "childPipeDrained": true, "exitStatusPreserved": true }
    },
    {
      "id": "d2.process.output-redaction-before-buffer",
      "description": "Synthetic credential markers are redacted before transport, logging, or evidence staging.",
      "given": { "chunks": ["Authorization: [fixture-credential]", "--password=[fixture-password]", "ordinary fixture output"], "declaredSensitiveArgIndexes": [2] },
      "expected": { "retainedChunks": ["Authorization: [REDACTED]", "--password=[REDACTED]", "ordinary fixture output"], "plaintextCredentialOccurrences": 0, "redactionBoundary": "before_transport_buffer" }
    },
    {
      "id": "d2.process.nmap-unprivileged-typed-argv",
      "description": "The first Nmap profile deterministically builds unprivileged typed argv.",
      "given": { "target": "192.0.2.10", "ports": [{ "from": 80, "to": 80 }, { "from": 443, "to": 443 }], "serviceDetection": true, "timingTemplate": "T4", "skipHostDiscovery": true, "versionIntensity": 7, "maximumRetries": 2, "xmlPath": "/var/lib/blackglass-runner/runs/run-fixture-19/nmap-xml" },
      "expected": { "executableRegistryId": "nmap-fixture-v1", "argv": ["-sT", "-sV", "-T4", "-Pn", "--version-intensity", "7", "--max-retries", "2", "-p", "80,443", "-oX", "/var/lib/blackglass-runner/runs/run-fixture-19/nmap-xml", "192.0.2.10"], "shell": false, "rawSocketCapability": false }
    },
    {
      "id": "d2.process.nmap-raw-flags-rejected",
      "description": "Raw flags and caller-selected output paths are not representable.",
      "given": { "target": "192.0.2.11", "rawFlags": ["--script", "fixture-script"], "outputPath": "/tmp/fixture-xml" },
      "error": { "code": "invalid_nmap_action_contract", "spawnCount": 0 }
    },
    {
      "id": "d2.process.nmap-privileged-mode-rejected",
      "description": "Privileged scan modes cannot expand the baseline runner's authority.",
      "given": { "target": "192.0.2.12", "requestedMode": "syn_scan", "runnerCapabilities": [] },
      "error": { "code": "nmap_capability_unsupported", "spawnCount": 0, "sudoAttempted": false, "capabilityAdded": false }
    }
  ]
}
